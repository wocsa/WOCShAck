# ── Django core ─────────────────────────────────────────────────────────────
# Which settings module to use (development | production)
DJANGO_SETTINGS_MODULE=djangoWocshack_5.settings.development

# A long random string. MUST be changed in production.
SECRET_KEY=change-me-to-a-long-random-string

# Set to False in production.
DEBUG=True

# Comma-separated hostnames. Use * only in development.
# Note: settings/development.py hard-codes ALLOWED_HOSTS=['*'] and
# CSRF_TRUSTED_ORIGINS=['https://*', 'http://*'] so all incoming origins are
# accepted in dev regardless of this value.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of trusted origins (scheme+host) for CSRF on HTTPS.
# Required in production when running behind a tunnel/reverse proxy whose
# Host header may not match the public hostname browsers use.
# Example: CSRF_TRUSTED_ORIGINS=https://example.com,https://*.3xploit.me
CSRF_TRUSTED_ORIGINS=

# Public base URL used to build the links in outbound emails (password reset,
# account activation). If empty, links fall back to the host of the incoming
# request — set this to the public https URL of the deployment in production.
# Example: SITE_URL=https://example.com
SITE_URL=

# ── Database ────────────────────────────────────────────────────────────────
# Leave empty to use default SQLite. Set a full URL for PostgreSQL/MySQL.
DATABASE_URL=

# ── Banking backend (VRC_Banking_System_Backend) ────────────────────────────
BANKING_HOST=172.28.0.2
BANKING_PORT=7051

# ── Webmail (Flask webmail server) ──────────────────────────────────────────
WEBMAIL_HOST=172.28.0.4
WEBMAIL_PORT=8080

# ── Email ───────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# ── Ollama LLM (chatbot RAG pipeline) ──────────────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=gemma3:1b
